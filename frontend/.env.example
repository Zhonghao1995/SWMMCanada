# Absolute URL of the deployed SWMMCanada backend, no trailing slash.
# Leave empty for local dev (Vite proxies /api to localhost:8000).
VITE_API_URL=
# Built-site base path. "/" for local/root hosting; "/SWMMCanada/" for the GitHub Pages project site.
VITE_BASE=/
# CARTO basemaps API key (free — carto.com/basemaps/apikey), appended to tile URLs at
# build time. Leave empty to build without one: tiles then carry CARTO's "API KEY
# REQUIRED" watermark but still render. The real key lives ONLY in .env.local
# (gitignored) and in the VITE_CARTO_KEY GitHub Actions secret — never commit it.
VITE_CARTO_KEY=
